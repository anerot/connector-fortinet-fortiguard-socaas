                    "tooltip": "Example : 04b6d298-8af2-4c68-a9b8-0123456789ab"
                }
            ],
            "enabled": true
        },
        {
            "operation": "get_list_reports",
            "title": "Report - Get List of Reports",
            "description": "Returns a list of reports",
            "category": "investigation",
            "annotation": "get_list_reports",
            "enabled": true
        },
        {
            "operation": "get_list_reports_client",
            "title": "Report - Get List of Reports for a Client",
            "description": "Returns a list of reports for the specified Client",
            "category": "investigation",
            "annotation": "get_list_reports_client",
            "parameters": [
                {
                    "title": "clientuuid",
