        {
            "operation": "generic_api_call",
            "title": "Generic API Call",
            "description": "Make a generic API call to FortiGuard SOCaaS.",
            "category": "investigation",
            "annotation": "generic_api_call",
            "parameters": [
                {
                    "title": "HTTP Method",
                    "type": "select",
                    "name": "method",
